			<key>label</key><string>Custom Hue 1</string>
			<key>min</key><real>0</real>
			<key>max</key><real>360</real>
			<key>interval</key><real>1</real>
			<key>footerText</key><string>0 = red, 120 = green, 190 = cyan, 258 = purple, 320 = pink.</string>
			<key>PostNotification</key><string>com.cocxace.glint/reload</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>defaults</key><string>com.cocxace.glint</string>
