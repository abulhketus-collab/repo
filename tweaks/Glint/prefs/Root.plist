<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Glint — Dynamic Island</string>
			<key>footerText</key><string>Master switch. Turning this off restores the stock status bar completely.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.cocxace.glint</string>
			<key>key</key><string>enableGlint</string>
			<key>label</key><string>Enabled</string>
			<key>PostNotification</key><string>com.cocxace.glint/reload</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Modules</string>
			<key>footerText</key><string>Every island feature has its own switch. With a tweak: events expand the island with spring animations. Without: stock silent banners only.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.cocxace.glint</string>
