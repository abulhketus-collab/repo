			<key>label</key><string>Notifications</string>
			<key>PostNotification</key><string>com.cocxace.glint/reload</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.cocxace.glint</string>
